# Copia este archivo con el nombre ".env" y cambia los datos por los de tu MySQL.
# Formato: mysql+pymysql://USUARIO:CONTRASEÑA@SERVIDOR:PUERTO/NOMBRE_BASE
DATABASE_URL=mysql+pymysql://root:TU_PASSWORD@localhost:3306/abarrotes_placencia

# Pon true SOLO si tu base de datos ya tiene triggers que actualizan stock y totales.
# (Ver README, sección "Triggers")
USAR_TRIGGERS_BD=false
